# Allowlist: everything is private unless explicitly re-included below.
/*

!/.gitignore
!/index.html
!/package.json
!/package-lock.json
!/vite.config.ts
!/tsconfig.json
!/tsconfig.app.json
!/tsconfig.node.json
!/public/
!/src/
!/.github/
/.github/*
!/.github/workflows/

# Never publish data, tests, secrets, or build output, even inside allowed folders.
/src/data/
/src/domain/
*.test.ts
*.test.tsx
.env
.env.*
*.local
node_modules
dist
coverage
*.log
